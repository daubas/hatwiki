---
import Layout from '../../components/Layout.astro';
import { getSiteWiki } from '../../lib/siteWiki.ts';

const page = await (await getSiteWiki()).readPage(Astro.params.slug ?? '');
if (!page) return new Response('Not found', { status: 404 });
const editable = Boolean(page.baseSha);
---

<Layout title={`編輯 ${page.title}`}>
  <p class="meta"><a href={`/wiki/${page.pageId}`}>← 回到頁面</a></p>
  <h1>編輯 {page.title}</h1>
  {!editable && <p class="card">這一頁尚未同步 Git revision，現在只能閱讀。</p>}
  <form id="edit-form" data-page-id={page.pageId} data-base-sha={page.baseSha ?? ''}>
    <label for="content">Markdown</label>
    <textarea id="content" name="content" rows="24" required disabled={!editable}>{page.sourceMarkdown ?? page.markdown}</textarea>
    <label for="reason">修改說明</label>
    <input id="reason" name="reason" required maxlength="160" disabled={!editable} />
    <label class="confirmation"><input name="authorizationConfirmed" type="checkbox" required disabled={!editable} /> 我確認有權將這份內容公開到 HatWiki。</label>
    <button type="submit" disabled={!editable}>送出修改</button>
    <a class="login" href="/auth/login">先用 GitHub 登入</a>
    <p id="result" role="status" aria-live="polite"></p>
  </form>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#edit-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const result = document.querySelector('#result');
    const data = new FormData(form);
    const response = await fetch('/api/edit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        requestId: crypto.randomUUID(),
        pageId: form.dataset.pageId,
        baseSha: form.dataset.baseSha,
        content: data.get('content'),
        reason: data.get('reason'),
        authorizationConfirmed: data.get('authorizationConfirmed') === 'on',
      }),
    });
    const receipt = await response.json() as { status?: string; error?: string };
    if (result) result.textContent = response.ok ? `已完成：${receipt.status}` : `無法送出：${receipt.error ?? response.status}`;
    if (response.status === 401) location.href = '/auth/login';
  });
</script>

<style>
  form { display:grid; gap:12px; }
  textarea, input { width:100%; padding:12px; border:1px solid var(--line); border-radius:8px; background:var(--panel); color:var(--text); font:inherit; }
  textarea { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; line-height:1.55; resize:vertical; }
  .confirmation { display:flex; gap:9px; align-items:flex-start; }
  .confirmation input { width:auto; margin-top:6px; }
  button, .login { width:max-content; padding:10px 15px; border-radius:8px; border:0; background:var(--accent); color:var(--panel); text-decoration:none; font:inherit; cursor:pointer; }
  .login { background:transparent; color:var(--accent); border:1px solid var(--line); }
</style>
