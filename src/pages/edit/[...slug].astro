---
import Layout from '../../components/Layout.astro';
import { getLocale, t, withLocale } from '../../lib/i18n.ts';
import { getSiteWiki } from '../../lib/siteWiki.ts';

const locale = getLocale(Astro.url);
const page = await (await getSiteWiki()).readPage(Astro.params.slug ?? '');
if (!page) return new Response(t(locale, 'notFound'), { status: 404 });
const loginUrl = withLocale('/auth/login', locale);
const sourceUrl = withLocale(`/api/edit-source/${page.pageId.split('/').map(encodeURIComponent).join('/')}`, locale);
const sourceTaskId = Astro.url.searchParams.get('sourceTask') ?? '';
---

<Layout title={`${t(locale, 'edit')} ${page.title}`}>
  <article class="edit-page" aria-labelledby="edit-page-title">
    <header class="edit-header">
      <a class="back-link" href={withLocale(`/wiki/${page.pageId}`, locale)}>← {t(locale, 'editBack')}</a>
      <p class="page-kicker">{t(locale, 'edit')} / {page.pageId}</p>
      <h1 id="edit-page-title">{t(locale, 'edit')} {page.title}</h1>
      <div class="page-meta"><span>{t(locale, 'graphRevision')} {page.revision}</span></div>
    </header>

    <p id="edit-notice" class="notice" role="status">{t(locale, 'editLoading')}</p>

    <form
      id="edit-form"
      class="edit-form"
      data-page-id={page.pageId}
      data-base-sha=""
      data-source-url={sourceUrl}
      data-login-url={loginUrl}
      data-completed={t(locale, 'completed')}
      data-unable={t(locale, 'unableToSubmit')}
      data-status-committed={t(locale, 'editStatusCommitted')}
      data-status-conflict={t(locale, 'editStatusConflict')}
      data-status-approval={t(locale, 'editStatusApproval')}
      data-status-unknown={t(locale, 'editStatusUnknown')}
      data-error-authentication={t(locale, 'editErrorAuthentication')}
      data-error-cross-origin={t(locale, 'editErrorCrossOrigin')}
      data-error-authorization={t(locale, 'editErrorAuthorization')}
      data-error-invalid-input={t(locale, 'editErrorInvalidInput')}
      data-error-not-found={t(locale, 'editErrorNotFound')}
      data-error-source-not-found={t(locale, 'editErrorSourceNotFound')}
      data-error-source-mismatch={t(locale, 'editErrorSourceMismatch')}
      data-error-source-citation={t(locale, 'editErrorSourceCitation')}
      data-error-source-used={t(locale, 'editErrorSourceUsed')}
      data-error-app-not-configured={t(locale, 'editErrorAppNotConfigured')}
      data-error-network={t(locale, 'editNetworkError')}
      data-error-unknown={t(locale, 'editErrorUnknown')}
      data-ready={t(locale, 'editReady')}
      data-read-only={t(locale, 'editReadOnly')}
      data-no-changes={t(locale, 'editNoChanges')}
      data-view-wiki={t(locale, 'viewWiki')}
      data-view-commit={t(locale, 'viewCommit')}
      data-change-affected={t(locale, 'changeAffected')}
      data-change-citations={t(locale, 'changeCitations')}
      data-change-links={t(locale, 'changeLinks')}
      data-change-unresolved={t(locale, 'changeUnresolved')}
      aria-describedby="edit-form-hint"
    >
      <p id="edit-form-hint" class="form-intro">{t(locale, 'editContentHint')}</p>
      <input name="sourceTaskId" type="hidden" value={sourceTaskId} />
      <fieldset id="edit-fields" disabled>
        <legend class="sr-only">{t(locale, 'editFormLegend')}</legend>
        <div class="field">
          <label for="content">{t(locale, 'editContent')}</label>
          <textarea id="content" name="content" rows="24" required aria-describedby="content-hint">{page.sourceMarkdown ?? page.markdown}</textarea>
          <p id="content-hint" class="field-hint">{t(locale, 'editContentHint')}</p>
        </div>
        <div class="field">
          <label for="reason">{t(locale, 'changeSummary')}</label>
          <input id="reason" name="reason" required maxlength="160" placeholder={t(locale, 'editReasonPlaceholder')} aria-describedby="reason-hint" />
          <p id="reason-hint" class="field-hint">{t(locale, 'editReasonHint')}</p>
        </div>
        <label class="confirmation"><input name="authorizationConfirmed" type="checkbox" required aria-describedby="authorization-hint" /> <span id="authorization-hint">{t(locale, 'publishAuthorization')}</span></label>
        <section class="diff-panel" aria-labelledby="diff-title">
          <h2 id="diff-title">{t(locale, 'editPreview')}</h2>
          <pre id="diff-preview">{t(locale, 'editNoChanges')}</pre>
        </section>
        <div class="edit-actions">
          <button class="submit-edit" type="submit">{t(locale, 'submitEdit')}</button>
          <a class="login" href={loginUrl}>{t(locale, 'signInFirst')}</a>
        </div>
      </fieldset>
      <p id="result" class="edit-result" role="status" aria-live="polite"></p>
      <p id="result-links" class="edit-result-links" hidden></p>
      <pre id="result-changes" class="result-changes" hidden></pre>
    </form>
  </article>
</Layout>

<script>
  import { editDiff, editResultMessage } from '../../lib/editUi.ts';

  const form = document.querySelector<HTMLFormElement>('#edit-form');
  const result = document.querySelector<HTMLElement>('#result');
  const resultLinks = document.querySelector<HTMLElement>('#result-links');
  const resultChanges = document.querySelector<HTMLElement>('#result-changes');
  const notice = document.querySelector<HTMLElement>('#edit-notice');
  const fields = document.querySelector<HTMLFieldSetElement>('#edit-fields');
  const content = document.querySelector<HTMLTextAreaElement>('#content');
  const preview = document.querySelector<HTMLElement>('#diff-preview');
  const submit = document.querySelector<HTMLButtonElement>('.submit-edit');
  const login = document.querySelector<HTMLElement>('.login');
  let originalContent = content?.value ?? '';
  const editRequestId = crypto.randomUUID();
  const labels = {
    completed: form?.dataset.completed || 'Completed',
    unableToSubmit: form?.dataset.unable || 'Unable to submit',
    status: {
      committed: form?.dataset.statusCommitted || 'Committed',
      conflict: form?.dataset.statusConflict || 'Conflict',
      approval_required: form?.dataset.statusApproval || 'Submitted for review',
    },
    error: {
      authentication_required: form?.dataset.errorAuthentication || 'Sign-in required',
      cross_origin_request: form?.dataset.errorCrossOrigin || 'Submit from the HatWiki page',
      authorization_required: form?.dataset.errorAuthorization || 'Publishing authorization is required',
      invalid_input: form?.dataset.errorInvalidInput || 'Invalid input',
      page_not_found: form?.dataset.errorNotFound || 'Page not found',
      source_not_found: form?.dataset.errorSourceNotFound || 'Source task not found',
      source_target_mismatch: form?.dataset.errorSourceMismatch || 'Source task targets another page',
      source_citation_missing: form?.dataset.errorSourceCitation || 'Source citation is required',
      source_already_used: form?.dataset.errorSourceUsed || 'Source task was already used',
      source_state_conflict: form?.dataset.errorSourceUsed || 'Source task state changed',
      request_conflict: form?.dataset.errorSourceUsed || 'Request ID was already used',
      request_in_progress: form?.dataset.errorSourceUsed || 'This request is already in progress',
      recovery_head_advanced: form?.dataset.errorSourceUsed || 'The page advanced while recovering this request',
      github_app_not_configured: form?.dataset.errorAppNotConfigured || 'The GitHub App is not configured',
      network_error: form?.dataset.errorNetwork || 'Network error',
    },
    unknownStatus: form?.dataset.statusUnknown || 'Response received',
    unknownError: form?.dataset.errorUnknown || 'Please try again later',
  };

  const updatePreview = () => {
    const diff = editDiff(originalContent, content?.value ?? '');
    if (preview) preview.textContent = diff || form?.dataset.noChanges || 'No changes yet.';
    if (submit) submit.disabled = !diff;
  };

  if (form) {
    fetch(form.dataset.sourceUrl || '')
      .then(async (response) => ({ response, payload: await response.json() }))
      .then(({ response, payload }) => {
        if (!response.ok) throw new Error(payload?.error || 'source_unavailable');
        originalContent = String(payload.content || '');
        if (content) content.value = originalContent;
        form.dataset.baseSha = String(payload.baseSha || '');
        if (fields) fields.disabled = false;
        if (notice) notice.textContent = form.dataset.ready || 'Ready to edit.';
        if (login) login.hidden = true;
        updatePreview();
      })
      .catch(() => {
        if (notice) notice.textContent = form.dataset.readOnly || 'This page is read-only.';
      });
  }
  content?.addEventListener('input', updatePreview);

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submit?.disabled) return;
    if (submit) submit.disabled = true;
    const data = new FormData(form);
    if (result) {
      result.dataset.state = 'pending';
      result.textContent = '';
    }
    try {
      const response = await fetch('/api/edit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          requestId: editRequestId,
          pageId: form.dataset.pageId,
          baseSha: form.dataset.baseSha,
          content: data.get('content'),
          reason: data.get('reason'),
          ...(data.get('sourceTaskId') ? { sourceTaskId: String(data.get('sourceTaskId')) } : {}),
          authorizationConfirmed: data.get('authorizationConfirmed') === 'on',
        }),
      });
      const receipt = await response.json() as { status?: string; error?: string; pageUrl?: string; revisionUrl?: string; changes?: { affectedPages?: string[]; citations?: string[]; wikiLinks?: string[]; unresolved?: string[] } };
      if (result) {
        result.dataset.state = response.ok ? 'success' : 'error';
        result.textContent = editResultMessage({ ok: response.ok, status: receipt.status, error: receipt.error }, labels);
      }
      if (response.ok && resultLinks) {
        resultLinks.replaceChildren();
        for (const [url, label] of [[receipt.pageUrl, form.dataset.viewWiki], [receipt.revisionUrl, form.dataset.viewCommit]]) {
          if (!url) continue;
          const link = document.createElement('a');
          link.href = url;
          link.textContent = label || url;
          resultLinks.append(link);
        }
        resultLinks.hidden = resultLinks.childElementCount === 0;
      }
      if (response.ok && receipt.changes && resultChanges) {
        const rows = [
          [form.dataset.changeAffected, receipt.changes.affectedPages],
          [form.dataset.changeCitations, receipt.changes.citations],
          [form.dataset.changeLinks, receipt.changes.wikiLinks],
          [form.dataset.changeUnresolved, receipt.changes.unresolved],
        ].filter(([, values]) => values?.length).map(([label, values]) => `${label}: ${values?.join(', ')}`);
        resultChanges.textContent = rows.join('\n');
        resultChanges.hidden = rows.length === 0;
      }
      if (response.status === 401) location.href = form.dataset.loginUrl || '/auth/login';
      if (!response.ok && submit) submit.disabled = false;
    } catch {
      if (result) {
        result.dataset.state = 'error';
        result.textContent = editResultMessage({ ok: false, error: 'network_error' }, labels);
      }
      if (submit) submit.disabled = false;
    }
  });
</script>

<style>
  .edit-page { min-width:0; }
  .edit-header { display:grid; gap:0; margin-bottom:28px; border-bottom:2px solid var(--line); padding-bottom:24px; }
  .back-link { width:max-content; color:var(--accent); font-size:.84rem; font-weight:800; text-decoration:none; }
  .back-link:hover { color:var(--text); }
  .page-kicker { margin:30px 0 0; color:var(--accent); font-size:.72rem; font-weight:850; letter-spacing:.12em; text-transform:uppercase; overflow-wrap:anywhere; }
  .edit-header h1 { margin:10px 0 14px; overflow-wrap:anywhere; }
  .page-meta { display:flex; flex-wrap:wrap; gap:14px; color:var(--muted); font-size:.84rem; }
  .notice { margin:0 0 24px; padding:16px; border:2px solid var(--accent); background:var(--soft); color:var(--text); line-height:1.6; }
  .edit-form { display:grid; gap:16px; min-width:0; }
  .form-intro { margin:0; color:var(--muted); line-height:1.6; }
  fieldset { display:grid; gap:20px; min-width:0; margin:0; padding:22px; border:2px solid var(--line); background:var(--panel); box-shadow:6px 6px 0 var(--line); }
  fieldset:disabled { opacity:.78; }
  .field { display:grid; gap:8px; min-width:0; }
  .field label { color:var(--text); font-size:.86rem; font-weight:850; }
  .field textarea, .field input { width:100%; min-width:0; padding:12px; border:2px solid var(--line); border-radius:0; background:var(--bg); color:var(--text); font:inherit; }
  .field textarea { min-height:320px; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; line-height:1.55; resize:vertical; }
  .field input { min-height:48px; }
  .field input::placeholder { color:var(--muted); opacity:1; }
  .field textarea:disabled, .field input:disabled { cursor:not-allowed; background:var(--soft); }
  .field-hint { margin:0; color:var(--muted); font-size:.78rem; line-height:1.5; }
  .confirmation { display:flex; align-items:flex-start; gap:10px; min-width:0; color:var(--text); line-height:1.5; }
  .confirmation input { flex:0 0 auto; width:20px; height:20px; margin:2px 0 0; accent-color:var(--accent); }
  .diff-panel { min-width:0; border:2px solid var(--line); background:var(--bg); }
  .diff-panel h2 { margin:0; padding:10px 12px; border-bottom:2px solid var(--line); font-size:.86rem; }
  .diff-panel pre { max-height:280px; margin:0; padding:14px; overflow:auto; white-space:pre-wrap; overflow-wrap:anywhere; font:0.82rem/1.55 ui-monospace,SFMono-Regular,Menlo,monospace; }
  .edit-actions { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .submit-edit, .login { display:inline-flex; align-items:center; justify-content:center; min-height:46px; padding:10px 15px; border:2px solid var(--line); border-radius:0; font:inherit; font-weight:850; text-decoration:none; }
  .submit-edit { background:var(--accent); color:var(--panel); cursor:pointer; box-shadow:3px 3px 0 var(--line); }
  .submit-edit:hover { background:var(--lime); color:var(--text); }
  .submit-edit:disabled { cursor:not-allowed; opacity:.55; box-shadow:none; }
  .login { background:transparent; color:var(--accent); }
  .login:hover { background:var(--soft); color:var(--text); }
  .edit-result { min-height:1.6em; margin:0; color:var(--muted); line-height:1.6; }
  .edit-result[data-state="success"] { color:var(--text); }
  .edit-result[data-state="error"] { color:#b42318; }
  .edit-result-links { display:flex; flex-wrap:wrap; gap:14px; margin:0; }
  .edit-result-links[hidden] { display:none; }
  .result-changes { margin:0; padding:14px; border:2px solid var(--line); background:var(--bg); white-space:pre-wrap; overflow-wrap:anywhere; }
  .result-changes[hidden] { display:none; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media (max-width:560px) {
    fieldset { padding:16px; }
    .edit-actions { display:grid; grid-template-columns:minmax(0,1fr); }
    .submit-edit, .login { width:100%; }
  }
</style>
