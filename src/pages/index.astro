---
import { getCollection } from 'astro:content';
import GraphView from '../components/GraphView.astro';
import Layout from '../components/Layout.astro';
import { getLocale, t, withLocale } from '../lib/i18n.ts';
import { getSiteSnapshot } from '../lib/siteWiki.ts';
import { buildWikiGraph } from '../lib/wikiGraph.ts';

const pages = (await getCollection('wiki')).filter((entry) => entry.data.visibility !== 'private');
const graph = buildWikiGraph(await getSiteSnapshot());
const locale = getLocale(Astro.url);
---

<Layout title="Humans and Agents Together">
  <section class="home">
    <header class="home-copy">
      <p class="status-line"><span aria-hidden="true"></span>{t(locale, 'homeStatus')}</p>
      <p class="overline">{t(locale, 'homeOverline')}</p>
      <h1>{t(locale, 'homeTitle1')}<br />{t(locale, 'homeTitle2')}<br /><strong>{t(locale, 'homeTitle3')}</strong></h1>
      <p class="home-lede">{t(locale, 'homeLede')}</p>
      <nav class="home-actions" aria-label={t(locale, 'homeExplore')}>
        <a class="primary-action" href={withLocale('/wiki', locale)}>{t(locale, 'homeRead')} <span aria-hidden="true">↗</span></a>
        <a href={withLocale('/graph', locale)}>{t(locale, 'homeOpenGraph')}</a>
      </nav>
    </header>

    <section class="loom" aria-labelledby="loom-title">
      <div class="loom-heading">
        <div>
          <p class="overline">{t(locale, 'homeMapOverline')}</p>
          <h2 id="loom-title">{t(locale, 'homeMapTitle')}</h2>
        </div>
        <div class="loom-meta">
          <p>{graph.nodes.length}<span>{t(locale, 'publicPages')}</span></p>
          <p>{graph.edges.length}<span>{t(locale, 'wikiLinks')}</span></p>
        </div>
      </div>
      <GraphView graph={graph} variant="loom" {locale} />
      <p class="loom-hint">{t(locale, 'homeMapHint')}</p>
    </section>

    <section class="collaborate" aria-labelledby="collaborate-title">
      <div class="collaborate-copy">
        <p class="overline">{t(locale, 'homeCollaborateOverline')}</p>
        <h2 id="collaborate-title">{t(locale, 'homeCollaborateTitle')}</h2>
        <p>{t(locale, 'homeCollaborateBody')}</p>
        <a class="primary-action" href={withLocale('/sources/new', locale)}>{t(locale, 'homeCollaborateAction')} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="collaborate-flow">
        <p class="flow-status"><span aria-hidden="true"></span>{t(locale, 'homeCollaborateStatus')}</p>
        <ol>
          <li><span>01</span>{t(locale, 'homeCollaborateStep1')}</li>
          <li><span>02</span>{t(locale, 'homeCollaborateStep2')}</li>
          <li><span>03</span>{t(locale, 'homeCollaborateStep3')}</li>
        </ol>
      </div>
    </section>

    <section class="public-pages" aria-labelledby="public-pages-title">
      <div class="public-pages-heading">
        <p class="overline">{t(locale, 'homeBrowseOverline')}</p>
        <h2 id="public-pages-title">{t(locale, 'homeBrowseTitle')}</h2>
        <a href={withLocale('/wiki', locale)}>{t(locale, 'homeBrowseAll')} →</a>
      </div>
      <ul>
        {pages.slice(0, 6).map((page) => <li><a href={withLocale(`/wiki/${page.id}`, locale)}><strong>{page.data.title}</strong><span>{page.data.description}</span></a></li>)}
      </ul>
    </section>
  </section>
</Layout>

<style>
  .home { display:grid; min-width:0; grid-template-columns:minmax(260px,380px) minmax(0,1fr); gap:clamp(28px,4vw,64px); align-items:start; }
  .home-copy { display:grid; align-content:start; min-width:0; }
  .status-line, .overline { margin:0; font-size:.72rem; font-weight:850; letter-spacing:.11em; text-transform:uppercase; }
  .status-line { justify-self:start; display:inline-flex; align-items:center; gap:8px; padding:7px 10px; border:1px solid var(--line); color:var(--muted); }
  .status-line span { width:8px; height:8px; border-radius:50%; background:var(--lime); box-shadow:0 0 14px var(--lime); }
  .overline { color:var(--cobalt); }
  .home-copy .overline { margin-top:54px; }
  .home-copy h1 { margin:14px 0 22px; font-size:clamp(3rem,5.3vw,5.8rem); letter-spacing:-.075em; line-height:.93; overflow-wrap:anywhere; }
  :global(html[lang="en"]) .home-copy h1 { font-size:clamp(2.8rem,3.5vw,3.2rem); letter-spacing:-.055em; line-height:.98; }
  .home-copy h1 strong { color:var(--lime); font-weight:inherit; }
  .home-lede { max-width:35rem; min-width:0; margin:0; color:var(--muted); font-size:clamp(.96rem,1.35vw,1.08rem); line-height:1.8; overflow-wrap:anywhere; }
  .home-actions { display:flex; flex-wrap:wrap; align-items:center; gap:18px; margin-top:34px; }
  .home-actions a { color:var(--text); font-size:.9rem; font-weight:800; text-decoration:none; }
  .home-actions a:not(.primary-action):hover { color:var(--cobalt); }
  .home-actions .primary-action { display:inline-flex; align-items:center; justify-content:space-between; gap:28px; min-height:48px; padding:10px 14px; background:var(--lime); color:#09111a; }
  .loom { position:relative; display:grid; min-width:0; gap:16px; }
  .loom-heading { display:flex; align-items:end; justify-content:space-between; gap:24px; }
  .loom-heading h2, .public-pages h2 { max-width:700px; margin:5px 0 0; font-size:clamp(1.45rem,3vw,2.3rem); letter-spacing:-.045em; line-height:1.15; }
  .loom-meta { display:flex; gap:24px; }
  .loom-meta p { display:grid; margin:0; color:var(--text); font-size:1.55rem; font-weight:800; line-height:1; }
  .loom-meta span { margin-top:5px; color:var(--muted); font-size:.68rem; font-weight:600; letter-spacing:.04em; }
  .loom-hint { justify-self:end; margin:0; color:var(--muted); font-size:.78rem; }
  .collaborate { grid-column:1 / -1; display:grid; grid-template-columns:minmax(0,.75fr) minmax(320px,1fr); gap:clamp(28px,5vw,72px); margin-top:34px; padding:clamp(24px,4vw,42px); border:1px solid var(--line); background:linear-gradient(135deg,rgb(138 230 255 / .08),rgb(214 255 74 / .06)); }
  .collaborate-copy { display:grid; justify-items:start; align-content:start; }
  .collaborate h2 { margin:8px 0 14px; font-size:clamp(1.8rem,3.8vw,3.2rem); letter-spacing:-.055em; line-height:1.05; }
  .collaborate-copy > p:not(.overline) { max-width:600px; margin:0; color:var(--muted); }
  .collaborate .primary-action { display:inline-flex; align-items:center; justify-content:space-between; gap:28px; min-height:48px; margin-top:24px; padding:10px 14px; background:var(--lime); color:#09111a; font-size:.9rem; font-weight:850; text-decoration:none; }
  .collaborate-flow { align-self:stretch; padding:20px; border:1px solid var(--line); background:var(--panel); }
  .flow-status { display:flex; align-items:center; gap:8px; margin:0 0 16px; color:var(--muted); font-size:.74rem; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
  .flow-status span { width:8px; height:8px; border-radius:50%; background:var(--lime); box-shadow:0 0 14px var(--lime); }
  .collaborate-flow ol { display:grid; gap:0; margin:0; padding:0; list-style:none; counter-reset:none; }
  .collaborate-flow li { display:flex; align-items:center; gap:18px; min-height:64px; border-top:1px solid var(--line); color:var(--text); font-weight:800; }
  .collaborate-flow li span { color:var(--cobalt); font-size:.75rem; letter-spacing:.08em; }
  .public-pages { grid-column:1 / -1; display:grid; grid-template-columns:minmax(210px,.42fr) 1fr; gap:clamp(28px,5vw,72px); margin-top:34px; border-top:1px solid var(--line); padding-top:34px; }
  .public-pages-heading { display:grid; justify-items:start; align-content:start; }
  .public-pages-heading > a { margin-top:20px; color:var(--text); font-size:.85rem; font-weight:800; text-decoration:none; }
  .public-pages-heading > a:hover { color:var(--cobalt); }
  .public-pages ul { display:grid; gap:10px; margin:0; padding:0; list-style:none; }
  .public-pages a { display:flex; justify-content:space-between; gap:18px; padding:15px 0; border-bottom:1px solid var(--line); color:var(--text); text-decoration:none; }
  .public-pages a:hover strong { color:var(--cobalt); }
  .public-pages strong { font-size:1rem; }
  .public-pages span { max-width:350px; color:var(--muted); font-size:.88rem; line-height:1.45; }
  @media (max-width:760px) {
    .home { grid-template-columns:minmax(0,1fr); gap:54px; }
    .home-copy { position:static; }
    .home-copy, .loom, .loom-heading, .loom-heading > div, .collaborate, .public-pages { min-width:0; }
    .home-copy .overline { margin-top:38px; }
    .home-copy h1 { font-size:clamp(2.75rem,14vw,4rem); }
    .loom-heading, .collaborate, .public-pages { display:grid; grid-template-columns:minmax(0,1fr); gap:24px; }
    .loom-heading h2 { max-width:100%; overflow-wrap:anywhere; }
    .loom-meta { margin-top:8px; }
    .loom-hint { justify-self:start; }
    .public-pages { margin-top:0; }
    .public-pages a { display:grid; gap:4px; }
  }
</style>
