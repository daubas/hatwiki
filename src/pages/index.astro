---
import { getCollection } from 'astro:content';
import GraphView from '../components/GraphView.astro';
import GraphScope from '../components/GraphScope.astro';
import Layout from '../components/Layout.astro';
import { groupWikiIndexByType } from '../lib/homeCatalog.ts';
import { getLocale, t, withLocale } from '../lib/i18n.ts';
import { getSiteSnapshot } from '../lib/siteWiki.ts';
import { buildWikiGraph } from '../lib/wikiGraph.ts';
import { mergeWikiIndexPages, type WikiIndexItem } from '../lib/wikiIndex.ts';

const locale = getLocale(Astro.url);
const includeSources = Astro.url.searchParams.get('sources') === '1';
const snapshot = await getSiteSnapshot();
const graph = buildWikiGraph(snapshot, { includeSources });
const metadata: WikiIndexItem[] = (await getCollection('wiki')).map((entry) => ({
  id: entry.id,
  title: entry.data.title ?? entry.id,
  ...(entry.data.description ? { description: entry.data.description } : {}),
}));
const catalogPages = mergeWikiIndexPages(snapshot.pages, metadata).filter((item) => item.id !== 'index' && item.status !== 'archived');
const groupOrder = ['concepts', 'workflows', 'entities', 'facts', 'comparisons', 'prompts', 'cases', 'sources'];
const groups = groupWikiIndexByType(catalogPages, groupOrder);
const groupLabelKeys = {
  concepts: 'groupConcepts', workflows: 'groupWorkflows', entities: 'groupEntities', facts: 'groupFacts',
  comparisons: 'groupComparisons', prompts: 'groupPrompts', cases: 'groupCases', sources: 'groupSources',
} as const;
const groupLabel = (group: string) => (group in groupLabelKeys ? t(locale, groupLabelKeys[group as keyof typeof groupLabelKeys]) : group === 'root' ? t(locale, 'groupOther') : group);
const pageHref = (pageId: string) => `/wiki/${pageId.split('/').map(encodeURIComponent).join('/')}`;
---

<Layout title="Humans and Agents Together">
  <section class="home">
    <form class="home-search" role="search" action={withLocale('/wiki', locale)} method="get">
      <label for="home-q">{t(locale, 'wikiSearchLabel')}</label>
      <input id="home-q" name="q" type="search" placeholder={t(locale, 'wikiSearchPlaceholder')} autocomplete="off" spellcheck="false" />
      <p>{t(locale, 'homeSearchHint')}</p>
    </form>

    <section class="loom" aria-labelledby="loom-title">
      <div class="loom-heading">
        <div>
          <p class="overline">{t(locale, 'homeMapOverline')}</p>
          <h2 id="loom-title">{t(locale, 'homeMapTitle')}</h2>
        </div>
        <div class="loom-meta">
          <p>{graph.nodes.length}<span>{t(locale, 'publicPages')}</span></p>
          <p>{graph.edges.length}<span>{t(locale, 'wikiLinks')}</span></p>
        </div>
      </div>
      <GraphScope {locale} {includeSources} />
      <GraphView graph={graph} variant="loom" {locale} />
      <p class="loom-hint">{t(locale, 'homeMapHint')}</p>
    </section>

    <section class="catalog" aria-labelledby="catalog-title">
      <h2 id="catalog-title">{t(locale, 'homeCatalogTitle')}</h2>
      {groups.map((group) => (
        <section class="catalog-group">
          <h3>{groupLabel(group.group)} <span>{group.items.length}</span></h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={withLocale(pageHref(item.id), locale)}>
                  <strong>{item.title}</strong>
                  {item.status && <em class="catalog-status">{item.status}</em>}
                  {item.description && <span>{item.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  </section>
</Layout>

<style>
  .home { display:grid; min-width:0; gap:clamp(28px,4vw,48px); }
  .overline { margin:0; color:var(--cobalt); font-size:.72rem; font-weight:850; letter-spacing:.11em; text-transform:uppercase; }
  .home-search { display:grid; gap:8px; max-width:720px; }
  .home-search label { color:var(--muted); font-size:.78rem; font-weight:800; }
  .home-search input { min-height:48px; padding:10px 14px; border:1px solid var(--line); background:var(--panel); color:var(--text); font:inherit; }
  .home-search input:focus-visible { outline:2px solid var(--cobalt); outline-offset:2px; }
  .home-search p { margin:0; color:var(--muted); font-size:.78rem; }
  .loom { position:relative; display:grid; min-width:0; gap:16px; }
  .loom-heading { display:flex; align-items:end; justify-content:space-between; gap:24px; }
  .loom-heading h2, .catalog h2 { max-width:700px; margin:5px 0 0; font-size:clamp(1.45rem,3vw,2.3rem); letter-spacing:-.045em; line-height:1.15; }
  .loom-meta { display:flex; gap:24px; }
  .loom-meta p { display:grid; margin:0; color:var(--text); font-size:1.55rem; font-weight:800; line-height:1; }
  .loom-meta span { margin-top:5px; color:var(--muted); font-size:.68rem; font-weight:600; letter-spacing:.04em; }
  .loom-hint { justify-self:end; margin:0; color:var(--muted); font-size:.78rem; }
  .catalog { display:grid; gap:28px; padding-top:28px; border-top:1px solid var(--line); }
  .catalog-group h3 { margin:0 0 6px; padding-bottom:8px; border-bottom:1px solid var(--line); font-size:1.05rem; }
  .catalog-group h3 span { margin-left:8px; color:var(--muted); font-size:.74rem; font-weight:600; }
  .catalog-group ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:clamp(24px,4vw,56px); margin:0; padding:0; list-style:none; }
  .catalog-group a { display:grid; gap:2px; min-width:0; padding:10px 0; border-bottom:1px solid var(--line); color:var(--text); text-decoration:none; }
  .catalog-group a:hover strong { color:var(--cobalt); }
  .catalog-group strong { font-size:.95rem; overflow-wrap:anywhere; }
  .catalog-group span { color:var(--muted); font-size:.82rem; line-height:1.45; overflow-wrap:anywhere; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .catalog-status { justify-self:start; color:var(--muted); font-size:.68rem; font-style:normal; letter-spacing:.06em; text-transform:uppercase; }
  @media (max-width:760px) {
    .loom-heading { display:grid; gap:12px; }
    .loom-hint { justify-self:start; }
    .catalog-group ul { grid-template-columns:minmax(0,1fr); }
  }
</style>
