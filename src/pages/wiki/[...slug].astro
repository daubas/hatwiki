---
import Layout from '../../components/Layout.astro';
import GraphView from '../../components/GraphView.astro';
import WikiStatus from '../../components/WikiStatus.astro';
import WikiContents from '../../components/WikiContents.astro';
import { getLocale, t, withLocale } from '../../lib/i18n.ts';
import { renderWiki } from '../../lib/renderWiki.ts';
import { getSiteSnapshot } from '../../lib/siteWiki.ts';
import { createPublicWiki } from '../../lib/publicWiki.ts';
import { buildLocalWikiGraph } from '../../lib/wikiGraph.ts';
import { addHeadingIds, extractWikiOutline, removeLeadingTitle } from '../../lib/wikiOutline.ts';
import { isDraftStatus } from '../../lib/contracts.ts';
import { diffMarkdown } from '../../lib/variantDiff.ts';

const snapshot = await getSiteSnapshot();
const wiki = createPublicWiki({ readSnapshot: async () => snapshot });
const locale = getLocale(Astro.url);
const pageId = Astro.params.slug ?? '';
const requestedVariant = Astro.url.searchParams.get('variant')?.trim() || undefined;
const page = await wiki.readPage(pageId, requestedVariant);
if (!page) return new Response(t(locale, 'notFound'), { status: 404 });
const primaryPage = requestedVariant ? await wiki.readPage(pageId) : page;
const localGraph = buildLocalWikiGraph(snapshot, page.pageId);
const pageHref = (id: string) => withLocale(`/wiki/${id.split('/').map(encodeURIComponent).join('/')}`, locale);
const editHref = withLocale(`/edit/${page.pageId.split('/').map(encodeURIComponent).join('/')}`, locale);
const outline = extractWikiOutline(page.markdown);
const html = addHeadingIds(removeLeadingTitle(await renderWiki(page.markdown, page.pageId)), outline);
const hasDiagnostics = page.links.some((link) => link.status !== 'resolved');
const variants = page.variants ?? [];
const versionHref = (variantId?: string) => {
  const path = `/wiki/${page.pageId.split('/').map(encodeURIComponent).join('/')}`;
  const localized = withLocale(path, locale);
  return variantId ? `${localized}${localized.includes('?') ? '&' : '?'}variant=${encodeURIComponent(variantId)}` : localized;
};
const diff = requestedVariant && primaryPage ? diffMarkdown(primaryPage.markdown, page.markdown) : [];
const citationHref = (resource: string) => {
  if (/^https?:\/\//i.test(resource)) return resource;
  if (resource.startsWith('/raw/')) return undefined;
  if (resource.startsWith('/') && resource.endsWith('.md')) return pageHref(resource.slice(1, -3));
  return undefined;
};
const canonicalSource = page.resource && /^https?:\/\//i.test(page.resource) ? page.resource : undefined;
const hasSources = Boolean(canonicalSource || page.citations?.length);
---

<Layout title={page.title}>
  <article class="wiki-page" aria-labelledby="wiki-page-title">
    <header class="wiki-page-header">
      <nav class="breadcrumbs" aria-label={t(locale, 'breadcrumbs')}>
        <a href={withLocale('/', locale)}>{t(locale, 'home')}</a><span aria-hidden="true">/</span>
        <a href={withLocale('/wiki', locale)}>{t(locale, 'wiki')}</a><span aria-hidden="true">/</span>
        <span aria-current="page">{page.title}</span>
      </nav>
      <h1 id="wiki-page-title">{page.title}</h1>
      <nav class="page-tabs" aria-label={locale === 'en' ? 'Page actions' : '頁面操作'}>
        <a href="#wiki-content" aria-current="page">{locale === 'en' ? 'Read' : '閱讀'}</a>
        <a href={editHref}>{locale === 'en' ? 'Edit source' : '編輯原稿'}</a>
        <a href="#page-information">{locale === 'en' ? 'Page information' : '頁面資訊'}</a>
      </nav>
      {page.description && <p class="page-description">{page.description}</p>}
      {requestedVariant && <p class="version-notice">{t(locale, 'pageSelectedVersion')} · <a href={versionHref()}>{t(locale, 'pagePrimaryVersion')}</a></p>}
    </header>

    <WikiStatus status={requestedVariant ? undefined : page.status} staleAfter={requestedVariant ? undefined : page.staleAfter} pendingCandidates={requestedVariant ? undefined : page.pendingCandidates} {locale} />
    <WikiContents {outline} {hasSources} {locale} position="inline" />
    {page.pageId.startsWith('sources/') && <p class="source-notice">{locale === 'en' ? 'This page summarizes a source. Check the original evidence before using its claims.' : '這是來源摘要頁。引用其中的說法前，請回到原始資料核對。'}</p>}

    {variants.length > 0 && <section class="wiki-versions" aria-labelledby="wiki-versions-title">
      <p class="section-kicker" id="wiki-versions-title">{t(locale, 'pageVersions')}</p>
      <p class="versions-hint">{t(locale, 'pageVersionsHint')}</p>
      <div class="version-list">
        <a class:list={['version-card', { 'version-card--selected': !requestedVariant }]} href={versionHref()}>
          <strong>{primaryPage?.title ?? page.title}</strong>
          <span>{t(locale, 'pagePrimaryVersion')}</span>
        </a>
        {variants.map((variant) => <a class:list={['version-card', { 'version-card--selected': requestedVariant === variant.variantId }]} href={versionHref(variant.variantId)}>
          <strong>{variant.title}</strong>
          <span>{t(locale, 'pageOtherVersion')} · {variant.revision.slice(0, 10)}</span>
          <small>{t(locale, 'pageVariantViews')} {variant.support.views} · {t(locale, 'pageVariantEndorsements')} {variant.support.endorsements} · {t(locale, 'pageVariantDisagreements')} {variant.support.disagreements}</small>
        </a>)}
      </div>
      {requestedVariant && primaryPage && <details class="version-diff">
        <summary>{t(locale, 'pageViewDiff')}</summary>
        <pre>{diff.map((line) => `${line.kind === 'added' ? '+ ' : line.kind === 'removed' ? '- ' : '  '}${line.text}`).join('\n')}</pre>
      </details>}
    </section>}

    <section id="wiki-content" class="wiki-content" aria-label={locale === 'en' ? 'Article content' : '條目內容'} set:html={html} />

    {(canonicalSource || (page.citations && page.citations.length > 0)) && <section class="wiki-sources" aria-labelledby="wiki-sources-title">
      <h2 id="wiki-sources-title">{t(locale, 'sources')}</h2>
      <ul>
        {canonicalSource && <li><a href={canonicalSource}>{page.title} ↗</a></li>}
        {page.citations?.filter((source) => source.resource !== canonicalSource).map((source) => {
        const href = citationHref(source.resource);
        return <li>{href
          ? <a href={href}>{source.title ?? source.resource}</a>
          : <><span>{source.title ?? source.resource}</span> <small>({t(locale, 'sourceUnavailable')})</small></>}
        </li>;
      })}</ul>
    </section>}
    <details id="page-information" class="page-information">
      <summary>{locale === 'en' ? 'Page information' : '頁面資訊'}</summary>
      <dl>
        <dt>{t(locale, 'wikiPageId')}</dt><dd><code>{page.pageId}</code></dd>
        <dt>{t(locale, 'graphRevision')}</dt><dd><code>{page.revision}</code></dd>
      </dl>
      <a href={editHref}>{locale === 'en' ? 'Open the source editor' : '開啟原稿編輯器'}</a>
    </details>
  </article>

  <div slot="right" class="wiki-side">
    <WikiContents {outline} {hasSources} {locale} />
    <section aria-labelledby="wiki-local-graph-title">
      <h2 id="wiki-local-graph-title">{locale === 'en' ? 'Page connections' : '條目關聯圖'}</h2>
      <p class="graph-hint">{locale === 'en' ? 'One link away · select a node to read it.' : '一層連結範圍 · 選取節點即可前往閱讀'}{requestedVariant && (locale === 'en' ? ' Based on the primary version.' : '（以主版本連結為準）')}</p>
      <GraphView graph={localGraph} variant="local" focusPageId={page.pageId} {locale} />
      <a class="global-graph-link" href={withLocale('/graph', locale)}>{locale === 'en' ? 'Explore the full graph →' : '探索完整知識圖譜 →'}</a>
    </section>
    {(page.linkedPages.length > 0 || page.backlinks.length > 0) && <details class="related-pages">
      <summary>{t(locale, 'wikiRelated')}</summary>
      <div class="related-pages-body">
      {page.linkedPages.length > 0 && <>
        <p class="side-label">{t(locale, 'linksOut')}</p>
        <ul>{page.linkedPages.map((linkedPage) => <li><a href={pageHref(linkedPage.pageId)}>{linkedPage.title}</a></li>)}</ul>
      </>}
      {page.backlinkPages.length > 0 && <>
        <p class="side-label">{t(locale, 'backlinks')}</p>
        <ul class="backlink-list">{page.backlinkPages.map((backlink) => <li class="backlink-item" title={backlink.snippet ? `「${backlink.snippet}」` : undefined}>
          <a class="backlink-title" href={pageHref(backlink.pageId)}>{backlink.title}</a>
          {isDraftStatus(backlink.status) && <span class="draft-badge">{t(locale, 'draftBadge')}</span>}
          {backlink.alias && <span class="backlink-alias">{locale === 'en' ? 'Term: ' : '詞：'}<strong>{backlink.alias}</strong></span>}
        </li>)}</ul>
      </>}
      </div>
    </details>}
    {hasDiagnostics && <details class="related-pages">
      <summary>{t(locale, 'linkDiagnostics')}</summary>
      <ul>{page.links.filter((link) => link.status !== 'resolved').map((link) => <li><code>{link.target}</code><span>{t(locale, link.status === 'ambiguous' ? 'linkAmbiguous' : 'linkUnresolved')}</span></li>)}</ul>
    </details>}
  </div>
</Layout>

<style>
  .wiki-page { min-width:0; }
  .wiki-page-header { margin-bottom:20px; }
  .breadcrumbs { display:flex; flex-wrap:wrap; gap:8px; color:var(--muted); font-size:.78rem; }
  .breadcrumbs a { color:inherit; text-decoration:none; }
  .breadcrumbs a:hover { color:var(--accent); text-decoration:underline; }
  .wiki-page-header h1 { margin:16px 0 12px; font-weight:800; font-size:clamp(2rem,3.5vw,2.75rem); line-height:1.35; overflow-wrap:anywhere; }
  .page-tabs { display:flex; flex-wrap:wrap; gap:24px; margin-bottom:20px; border-bottom:1px solid var(--line); font-size:.85rem; }
  .page-tabs a { padding:8px 0; color:var(--muted); text-decoration:none; }
  .page-tabs a:hover { color:var(--accent); }
  .page-tabs a[aria-current] { border-bottom:2px solid var(--lime); color:var(--lime); }
  .page-description { margin:0; font-size:1.05rem; line-height:1.85; }
  .version-notice, .source-notice { color:var(--muted); font-size:.86rem; line-height:1.65; }
  .source-notice { padding:10px 14px; border-left:3px solid var(--line); background:var(--panel); }
  .section-kicker { margin:0 0 8px; font-size:.9rem; font-weight:700; }
  .wiki-versions { margin:24px 0; border:1px solid var(--line); padding:16px; background:var(--panel); }
  .versions-hint { margin:0 0 14px; color:var(--muted); font-size:.85rem; }
  .version-list { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:8px; }
  .version-card { display:grid; gap:4px; min-width:0; border:1px solid var(--line); padding:12px; color:var(--text); text-decoration:none; background:var(--bg); overflow-wrap:anywhere; }
  .version-card:hover, .version-card--selected { border-color:var(--accent); background:var(--soft); }
  .version-card span, .version-card small { color:var(--muted); font-size:.78rem; }
  .version-diff { margin-top:16px; }
  .version-diff summary { cursor:pointer; color:var(--accent); }
  .version-diff pre { max-height:360px; overflow:auto; padding:14px; background:var(--soft); white-space:pre-wrap; overflow-wrap:anywhere; }
  .wiki-content { min-width:0; margin-top:28px; font-size:1rem; line-height:1.85; overflow-wrap:anywhere; }
  .wiki-content :global(p), .wiki-content :global(li) { line-height:1.85; }
  .wiki-content :global(h2), .wiki-sources h2 { margin:32px 0 16px; padding-bottom:6px; border-bottom:1px solid var(--line); font-size:1.4rem; font-weight:700; line-height:1.5; }
  .wiki-content :global(h3) { margin:24px 0 12px; font-size:1.15rem; line-height:1.6; }
  .wiki-content :global(h4), .wiki-content :global(h5), .wiki-content :global(h6) { font-size:1rem; line-height:1.65; }
  .wiki-content :global(h2), .wiki-content :global(h3), #wiki-page-title, #wiki-content, #wiki-sources-title, #page-information { scroll-margin-top:100px; }
  .wiki-content :global(table) { display:block; max-width:100%; overflow:auto; border-collapse:collapse; font-size:.92rem; }
  .wiki-content :global(th), .wiki-content :global(td) { border:1px solid var(--line); padding:8px 12px; line-height:1.65; }
  .wiki-content :global(th) { background:var(--panel); }
  .wiki-content :global(pre) { max-width:100%; overflow:auto; padding:16px; background:var(--panel); border:1px solid var(--soft); font-size:.88rem; }
  .wiki-content :global(img) { max-width:100%; height:auto; }
  .wiki-content :global(blockquote) { margin:20px 0; padding:0 20px; border-left:3px solid var(--line); color:var(--muted); }
  .wiki-sources { margin-top:32px; }
  .wiki-sources ul, .wiki-side ul { margin:0; padding-left:18px; }
  .wiki-sources li, .wiki-side li { margin-bottom:8px; overflow-wrap:anywhere; line-height:1.65; }
  .wiki-sources small { color:var(--muted); }
  .page-information { margin-top:32px; padding:16px 0; border-top:1px solid var(--line); color:var(--muted); font-size:.8rem; overflow-wrap:anywhere; }
  .page-information summary { cursor:pointer; color:var(--text); }
  .page-information dl { display:grid; grid-template-columns:auto minmax(0,1fr); gap:8px 16px; }
  .page-information dd { margin:0; }
  .wiki-side { display:grid; gap:28px; padding-right:4px; }
  .related-pages summary { display:flex; align-items:center; gap:8px; padding-bottom:12px; border-bottom:1px solid var(--line); color:var(--text); font-size:.85rem; font-weight:700; cursor:pointer; }
  .related-pages summary::before { content:"＋"; color:var(--accent); }
  .related-pages[open] summary::before { content:"−"; }
  .related-pages-body, .related-pages > ul { margin-top:16px !important; }
  .wiki-side section { min-width:0; }
  .wiki-side h2 { margin:0 0 12px; padding-bottom:8px; border-bottom:1px solid var(--soft); color:var(--text); font-size:.9rem; line-height:1.5; }
  .wiki-side .side-label { margin:0 0 8px; font-size:.8rem; font-weight:700; }
  .wiki-side ul + .side-label { margin-top:20px; }
  .wiki-side a { color:var(--accent); overflow-wrap:anywhere; }
  .wiki-side code { display:block; overflow-wrap:anywhere; color:var(--text); font:inherit; }
  .wiki-side li span { display:block; color:var(--muted); font-size:.78rem; }
  .graph-hint { margin:0 0 12px; color:var(--muted); font-size:.76rem; line-height:1.6; }
  .global-graph-link { display:inline-block; margin-top:10px; font-size:.82rem; }
  .backlink-list { list-style:none; padding-left:0 !important; display:grid; gap:12px; }
  .backlink-item a { font-size:.85rem; line-height:1.55; text-decoration:none; }
  .backlink-item a:hover { text-decoration:underline; }
  .backlink-alias { margin-top:3px; }
  .draft-badge { display:inline-block !important; padding:1px 5px; border:1px solid #a89050; color:#eed08d !important; font-size:.7rem !important; }
  @media (max-width:900px) {
    .wiki-content :global(h2), .wiki-content :global(h3), #wiki-page-title, #wiki-content, #wiki-sources-title, #page-information { scroll-margin-top:160px; }
  }
  @media (max-width:760px) {
    .wiki-page-header h1 { font-size:1.8rem; }
    .wiki-content :global(h2), .wiki-content :global(h3), #wiki-page-title, #wiki-content, #wiki-sources-title, #page-information { scroll-margin-top:210px; }
    .wiki-content { font-size:1rem; }
  }
</style>
