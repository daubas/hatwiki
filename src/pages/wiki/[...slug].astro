---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { createCollectionProjection } from '../../lib/collectionProjection.ts';
import { createPublicWiki } from '../../lib/publicWiki.ts';
import { renderWiki } from '../../lib/renderWiki.ts';

const entries = await getCollection('wiki');
const wiki = createPublicWiki(createCollectionProjection('local-fixture', entries));
const page = await wiki.readPage(Astro.params.slug ?? '');
if (!page) return new Response('Not found', { status: 404 });
const html = await renderWiki(page.markdown);
---

<Layout title={page.title}>
  <p class="meta">Revision {page.revision}</p>
  <article set:html={html} />
  {page.citations && page.citations.length > 0 && <section class="card"><h2>Sources</h2><ul>{page.citations.map((source) => <li><a href={source.resource}>{source.title ?? source.resource}</a></li>)}</ul></section>}
  <div slot="right">
    {page.backlinks.length > 0 && <><p class="label">Backlinks</p><ul>{page.backlinks.map((id) => <li><a href={`/wiki/${id}`}>{id}</a></li>)}</ul></>}
    {page.links.some((link) => link.status !== 'resolved') && <><p class="label">Link diagnostics</p><ul>{page.links.filter((link) => link.status !== 'resolved').map((link) => <li>{link.target}: {link.status}</li>)}</ul></>}
  </div>
</Layout>
