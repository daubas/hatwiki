---
import WebMcpRegistration from './WebMcpRegistration.astro';
import { getLocale, LOCALES, switchLocaleUrl, t, withLocale } from '../lib/i18n.ts';
const { title = 'HatWiki' } = Astro.props;
const pathname = Astro.url.pathname;
const pageClass = pathname === '/' ? 'home-page' : pathname === '/graph' ? 'graph-page' : 'reading-page';
const hasAside = Astro.slots.has('right');
const locale = getLocale(Astro.url);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={t(locale, 'metaDescription')} />
    <title>{title} · HatWiki</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">{locale === 'en' ? 'Skip to content' : '跳至內容'}</a>
    <WebMcpRegistration />
    <header class="site-header">
      <a class="brand" href={withLocale('/', locale)} aria-label={t(locale, 'home')}><img class="brand-mark" src="/brand/hatwiki.svg" alt="" /><span>HatWiki</span></a>
      <form class="site-search" action="/wiki" role="search">
        <label class="sr-only" for="site-search">{t(locale, 'wikiSearchLabel')}</label>
        {locale === 'en' && <input type="hidden" name="lang" value="en" />}
        <input id="site-search" name="q" type="search" placeholder={locale === 'en' ? 'Search HatWiki' : '搜尋 HatWiki'} value={Astro.url.searchParams.get('q') ?? ''} />
        <button type="submit">{locale === 'en' ? 'Search' : '搜尋'}</button>
      </form>
      <nav class="primary-nav" aria-label={t(locale, 'primaryNavigation')}>
        <a href={withLocale('/wiki', locale)} aria-current={pathname.startsWith('/wiki') ? 'page' : undefined}>{t(locale, 'wiki')}</a>
        <a href={withLocale('/graph', locale)} aria-current={pathname === '/graph' ? 'page' : undefined}>{t(locale, 'graph')}</a>
        <a href={withLocale('/sources/new', locale)} aria-current={pathname === '/sources/new' ? 'page' : undefined}>{t(locale, 'addSource')}</a>
      </nav>
      <div class="header-actions">
        <nav class="language-switch" aria-label={t(locale, 'language')}>
          {LOCALES.map((item) => <a href={switchLocaleUrl(Astro.url, item)} aria-current={item === locale ? 'page' : undefined}>{item === 'zh-Hant' ? '繁' : 'EN'}</a>)}
        </nav>
        <a
          id="account-link"
          class="account"
          href={withLocale('/auth/login', locale)}
          data-login-url={withLocale('/auth/login', locale)}
          data-logout-url={withLocale('/auth/logout', locale)}
          data-login-label={`GitHub ${t(locale, 'login')}`}
          data-signed-in-label={t(locale, 'signedInAs')}
          data-logout-label={t(locale, 'logout')}
        ><span id="account-label"><span class="account-long">GitHub&nbsp;</span>{t(locale, 'login')}</span> <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <div class:list={['shell', { 'shell--with-aside': hasAside }]}>
      <main id="main-content" tabindex="-1"><slot /></main>
      {hasAside && <aside class="right-sidebar"><slot name="right" /></aside>}
    </div>
  </body>
</html>

<script>
  const accountLink = document.querySelector<HTMLAnchorElement>('#account-link');
  const accountLabel = document.querySelector<HTMLElement>('#account-label');
  if (accountLink && accountLabel) {
    fetch('/api/session')
      .then((response) => response.json())
      .then(({ actor }) => {
        if (!actor?.login) return;
        accountLink.href = accountLink.dataset.logoutUrl || '/auth/logout';
        accountLink.title = accountLink.dataset.logoutLabel || 'Log out';
        accountLink.dataset.authenticated = 'true';
        accountLabel.textContent = `${accountLink.dataset.signedInLabel || 'Signed in'} · @${actor.login}`;
      })
      .catch(() => {});
  }
</script>

<style is:global>
  :root { color-scheme:dark; --bg:#09111a; --panel:#101c27; --text:#f5f2e8; --muted:#a8b2b8; --line:#40505c; --accent:#8ae6ff; --cobalt:#8ae6ff; --lime:#d6ff4a; --soft:#182733; }
  * { box-sizing:border-box; }
  html, body { overflow-x:clip; }
  html { background:var(--bg); }
  body { min-width:0; min-height:100vh; margin:0; background:var(--bg); color:var(--text); font-family:"Avenir Next","Avenir","PingFang TC","Noto Sans TC","Helvetica Neue",Arial,sans-serif; }
  .site-header { position:sticky; top:0; z-index:10; display:grid; grid-template-columns:auto minmax(160px,1fr) auto auto; align-items:center; gap:24px; min-height:72px; padding:12px clamp(16px,3vw,40px); border-bottom:1px solid var(--line); background:rgb(9 17 26 / .92); backdrop-filter:blur(14px); }
  .brand { display:inline-flex; align-items:center; gap:10px; color:var(--text); font-size:1.24rem; font-weight:900; letter-spacing:-.05em; text-decoration:none; }
  .brand-mark { width:36px; height:36px; object-fit:contain; }
  .label { margin:0; color:var(--muted); font-size:.78rem; letter-spacing:.04em; }
  .primary-nav { display:flex; justify-self:center; gap:7px; }
  .primary-nav a { display:inline-flex; align-items:center; justify-content:center; min-height:42px; padding:8px 14px; border:2px solid transparent; color:var(--text); font-size:.88rem; font-weight:750; text-decoration:none; }
  .primary-nav a:hover, .primary-nav a[aria-current="page"] { border-color:var(--line); background:var(--lime); box-shadow:3px 3px 0 var(--line); color:var(--bg); }
  .account { display:inline-flex; align-items:center; justify-content:center; min-height:42px; padding:8px 13px; border:1px solid var(--lime); background:transparent; color:var(--lime); font-size:.88rem; font-weight:700; text-decoration:none; white-space:nowrap; }
  .site-search { display:flex; width:min(100%,420px); min-width:0; }
  .site-search input { min-width:0; width:100%; min-height:36px; border:1px solid var(--line); padding:6px 10px; background:var(--bg); color:var(--text); font:inherit; font-size:.88rem; }
  .site-search button { flex:none; border:1px solid var(--line); border-left:0; padding:6px 12px; background:var(--panel); color:var(--text); font:inherit; font-size:.82rem; cursor:pointer; }
  .site-search button:hover { border-color:var(--accent); background:var(--accent); color:var(--bg); }
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  .skip-link { position:fixed; top:-100px; left:16px; z-index:20; padding:12px; background:var(--bg); color:var(--accent); }
  .skip-link:focus { top:8px; }
  .header-actions, .language-switch { display:flex; align-items:center; gap:8px; }
  .language-switch a { padding:5px 3px; color:var(--muted); font-size:.7rem; font-weight:800; text-decoration:none; }
  .language-switch a[aria-current="page"] { color:var(--text); text-decoration:underline; text-underline-offset:4px; }
  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline:3px solid var(--cobalt); outline-offset:3px; }
  .shell { width:min(calc(100% - 48px), 840px); margin:auto; padding:48px 0 76px; }
  .shell--with-aside { display:grid; width:min(calc(100% - 64px),1136px); grid-template-columns:minmax(0,1fr) 280px; gap:56px; align-items:start; }
  .right-sidebar { min-width:0; }
  .home-page .shell, .graph-page .shell { width:min(calc(100% - 48px), 1320px); }
  body.home-page { background-image:linear-gradient(rgb(138 230 255 / .055) 1px,transparent 1px),linear-gradient(90deg,rgb(138 230 255 / .055) 1px,transparent 1px); background-size:40px 40px; }
  body.reading-page { background-image:none; }
  .graph-page .shell { padding-top:38px; }
  main { min-width:0; }
  #main-content { scroll-margin-top:90px; }
  main h1 { margin:0 0 18px; font-size:clamp(1.8rem,4vw,2.5rem); letter-spacing:normal; line-height:1.35; }
  main h2 { margin-top:2rem; }
  main p, main li { line-height:1.75; }
  main a { color:var(--accent); }
  .right-sidebar { position:sticky; top:104px; align-self:start; max-height:calc(100svh - 128px); overflow:auto; padding-left:0; color:var(--muted); font-size:.9rem; }
  .card { padding:22px; border:1px solid var(--line); border-radius:0; background:var(--panel); }
  .meta { color:var(--muted); font-size:.85rem; }
  .tags { display:flex; flex-wrap:wrap; gap:6px; margin:16px 0; }
  .tags span { border:1px solid var(--line); background:var(--lime); border-radius:0; padding:4px 9px; color:var(--bg); font-size:.78rem; }
  @media (max-width:1200px) {
    .site-header { gap:12px; }
    .primary-nav a { padding-inline:8px; }
  }
  @media (max-width:900px) {
    #main-content { scroll-margin-top:160px; }
    .shell--with-aside { display:block; }
    .right-sidebar { position:static; max-height:none; overflow:visible; margin-top:36px; border-top:1px solid var(--line); padding-top:20px; }
    .site-header { grid-template-columns:auto minmax(140px,1fr) auto; }
    .primary-nav { grid-column:1 / -1; grid-row:2; justify-self:start; }
    .header-actions { grid-column:3; grid-row:1; }
  }
  @media (max-width:760px) {
    #main-content { scroll-margin-top:210px; }
    .site-header { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:10px; padding:11px 16px 14px; }
    .brand { min-height:46px; }
    .site-search { grid-column:1 / -1; grid-row:2; width:100%; }
    .primary-nav { display:grid; width:100%; min-width:0; grid-column:1 / -1; grid-row:3; margin-top:0; grid-template-columns:repeat(3,minmax(0,1fr)); gap:9px; }
    .header-actions { position:static; grid-column:2; grid-row:1; justify-self:end; }
    .language-switch a[aria-current="page"] { display:none; }
    .account { min-width:72px; padding-inline:8px; }
    .account-long { display:none; }
    .primary-nav a, .account { min-height:46px; padding-inline:7px; }
    .shell, .shell--with-aside, .home-page .shell, .graph-page .shell { display:block; width:calc(100% - 32px); padding:24px 0 56px; }
    .right-sidebar { margin-top:36px; border-top:1px solid var(--line); padding-top:20px; }
  }
  @media (prefers-reduced-motion:reduce) { *, *::before, *::after { scroll-behavior:auto !important; transition-duration:.01ms !important; animation-duration:.01ms !important; animation-iteration-count:1 !important; } }
</style>
