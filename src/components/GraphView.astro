---
import type { WikiGraph } from '../lib/wikiGraph.ts';
import { t, type Locale } from '../lib/i18n.ts';

const { graph, variant = 'graph', locale = 'zh-Hant', focusPageId } = Astro.props as { graph: WikiGraph; variant?: 'graph' | 'loom' | 'local'; locale?: Locale; focusPageId?: string };
const isLocal = variant === 'local';
const labels = {
  backlinks: t(locale, 'backlinks'),
  neighbors: t(locale, 'neighbors'),
  search: locale === 'en' ? 'Search nodes' : '搜尋節點',
  searchPlaceholder: locale === 'en' ? 'Title or path' : '標題或路徑',
  noResults: locale === 'en' ? 'No matching nodes' : '沒有符合的節點',
  details: locale === 'en' ? 'Node details' : '節點詳情',
  openPage: locale === 'en' ? 'Open page' : '閱讀頁面',
  localGraph: locale === 'en' ? 'Local graph' : '局部關聯圖',
  currentPage: locale === 'en' ? 'Current page' : '目前條目',
  localReset: locale === 'en' ? 'Reset view' : '重置視圖',
  localKeyboardHint: locale === 'en' ? 'Focus the graph, then use +/− to zoom or arrow keys to pan.' : '聚焦圖譜後，可用 +/− 縮放或方向鍵平移。',
  graphTypes: locale === 'en' ? 'Node types' : '節點類型',
};
const graphJson = JSON.stringify({ graph, locale, labels, focusPageId }).replaceAll('<', '\\u003c');
const groupHints: Record<string, string> = locale === 'en'
  ? { entities: 'Named objects: models, tools, and platforms', concepts: 'Reusable methods and mental models', facts: 'Time-sensitive numbers with scope and validity', comparisons: 'Comparisons of two or more objects or methods', workflows: 'End-to-end operating flows', prompts: 'Prompt modules ready to reuse', cases: 'Breakdowns of practical cases', sources: 'Source summaries, usually drafts', other: 'Other pages' }
  : { entities: '有名字的對象：模型、工具、平台', concepts: '可跨模型適用的做法與心智模型', facts: '會過期的數字，帶口徑與有效期', comparisons: '兩個以上對象或做法的比較', workflows: '端到端操作流程', prompts: '可直接重用的提示詞模組', cases: '實戰案例拆解', sources: '來源摘要（一份來源一頁，多為草稿）', other: '其他頁面' };
const groupLabels: Record<string, string> = locale === 'en'
  ? { entities: 'Entities', concepts: 'Concepts', facts: 'Facts', comparisons: 'Comparisons', workflows: 'Workflows', prompts: 'Prompts', cases: 'Cases', sources: 'Sources', other: 'Other' }
  : { entities: '實體', concepts: '概念', facts: '事實', comparisons: '比較', workflows: '工作流', prompts: '提示詞', cases: '案例', sources: '來源摘要', other: '其他' };
const presentGroups = new Set(graph.nodes.map((n: { group: string }) => (groupLabels[n.group] ? n.group : 'other')));
const legendGroups = Object.keys(groupLabels).filter((k) => presentGroups.has(k)).map((key) => ({ key, label: groupLabels[key] }));
---

<div class:list={['graph-wrap', 'card', `graph-wrap--${variant}`]}>
  <div class:list={['graph-tools', { 'graph-tools--local': isLocal }]}>
    <div class="graph-summary">
      <p>{isLocal ? labels.localGraph : variant === 'loom' ? t(locale, 'graphLoom') : t(locale, 'graphMap')}</p>
      <span>{graph.nodes.length} {t(locale, 'graphPages')} · {graph.edges.length} {t(locale, 'graphLinks')} · {t(locale, 'graphScaleHint')}</span>
    </div>
    {isLocal && <div class="graph-local-actions">
      <button data-graph-reset type="button">{labels.localReset}</button>
      <span>{labels.localKeyboardHint}</span>
    </div>}
    {!isLocal && <div class="graph-actions">
      <label class="graph-search">
        <span>{labels.search}</span>
        <input data-graph-search type="search" autocomplete="off" placeholder={labels.searchPlaceholder} />
      </label>
      <button data-graph-reset type="button">{t(locale, 'graphReset')}</button>
      <p class="graph-search-status" data-graph-search-status role="status" aria-live="polite" hidden></p>
    </div>}
  </div>
  {!isLocal && <ul class="graph-legend" aria-label={labels.graphTypes}>
    {legendGroups.map((g) => <li><button type="button" data-legend-group={g.key} aria-pressed="true" title={locale === 'en' ? `${g.label}: ${groupHints[g.key]} (click to show or hide)` : `${g.label}：${groupHints[g.key]}（點擊顯示／隱藏）`}><span class="swatch" style={`background:var(--group-${g.key})`}></span>{g.label}</button></li>)}
  </ul>}
  <svg id="wiki-graph" role="group" tabindex={isLocal ? 0 : undefined} aria-keyshortcuts={isLocal ? '+ - ArrowUp ArrowDown ArrowLeft ArrowRight' : undefined} aria-label={isLocal ? labels.localGraph : variant === 'loom' ? t(locale, 'graphAriaLoom') : t(locale, 'graphAriaMap')}></svg>
  <section class:list={['graph-detail', { 'graph-detail--local': isLocal }]} data-graph-detail aria-live="polite" tabindex="-1" hidden>
    <p class="label">{labels.details}</p>
    <strong data-graph-detail-title></strong>
    <p data-graph-detail-summary></p>
    <a data-graph-detail-link></a>
  </section>
  <script type="application/json" id="wiki-graph-data" set:html={graphJson} />
</div>

<script>
  import * as d3 from 'd3';
  import { focusedGraphNodeIds, graphKeyboardAction, matchingGraphNodeIds, observeResize } from '../lib/graphInteraction.ts';

  const element = document.querySelector<SVGSVGElement>('#wiki-graph');
  const dataElement = document.querySelector<HTMLScriptElement>('#wiki-graph-data');
  const wrapper = element?.closest<HTMLElement>('.graph-wrap');
  if (element && dataElement && wrapper) {
    const payload = JSON.parse(dataElement.textContent || '{"graph":{"nodes":[],"edges":[]},"locale":"zh-Hant","labels":{}}');
    const graph = payload.graph;
    const groupColors: Record<string, true> = { entities: true, concepts: true, facts: true, comparisons: true, workflows: true, prompts: true, cases: true, sources: true } as any;
    const labels = payload.labels;
    const searchInput = wrapper.querySelector<HTMLInputElement>('[data-graph-search]');
    const searchStatus = wrapper.querySelector<HTMLElement>('[data-graph-search-status]');
    const resetButton = wrapper.querySelector<HTMLButtonElement>('[data-graph-reset]');
    const detail = wrapper.querySelector<HTMLElement>('[data-graph-detail]');
    const detailTitle = wrapper.querySelector<HTMLElement>('[data-graph-detail-title]');
    const detailSummary = wrapper.querySelector<HTMLElement>('[data-graph-detail-summary]');
    const detailLink = wrapper.querySelector<HTMLAnchorElement>('[data-graph-detail-link]');
    const size = () => ({ width: element.clientWidth || 760, height: element.clientHeight || 560 });
    let { width, height } = size();
    const nodes = graph.nodes.map((node: any) => ({ ...node }));
    const links = graph.edges.map((edge: any) => ({ ...edge }));
    const nodeById = new Map(nodes.map((node: any) => [node.id, node]));
    const svg = d3.select(element).attr('viewBox', [0, 0, width, height]);
    const root = svg.append('g');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isLocal = element.closest('.graph-wrap--local') !== null;
    const maxConnections = d3.max(nodes, (node: any) => node.connections) || 1;
    const radius = d3.scaleSqrt().domain([0, maxConnections]).range(isLocal ? [4, 10] : [7, 18]);
    const isLoom = element.closest('.graph-wrap--loom') !== null;
    const focusPageId = typeof payload.focusPageId === 'string' ? payload.focusPageId : undefined;
    const labelThreshold = d3.quantile(nodes.map((node: any) => node.connections).sort(d3.ascending), 0.88) || 0;
    const idOf = (value: string | { id: string }) => typeof value === 'string' ? value : value.id;
    const pageHref = (id: string) => `/wiki/${id.split('/').map(encodeURIComponent).join('/')}${payload.locale === 'en' ? '?lang=en' : ''}`;
    const adjacency = new Map<string, Set<string>>();
    for (const edge of links) {
      if (!adjacency.has(edge.source)) adjacency.set(edge.source, new Set());
      if (!adjacency.has(edge.target)) adjacency.set(edge.target, new Set());
      adjacency.get(edge.source)?.add(edge.target);
      adjacency.get(edge.target)?.add(edge.source);
    }
    const labelOpacity = (node: any) => !isLoom || node.connections >= labelThreshold ? 1 : 0;
    const initialLabelOpacity = (node: any) => isLocal ? (node.id === focusPageId ? 1 : 0) : labelOpacity(node);
    let selectedId: string | undefined;

    svg.append('defs').append('marker')
      .attr('id', 'graph-arrow')
      .attr('viewBox', '0 -5 10 10')
      .attr('refX', 18)
      .attr('markerWidth', 5)
      .attr('markerHeight', 5)
      .attr('orient', 'auto')
      .append('path')
      .attr('d', 'M0,-5L10,0L0,5')
      .attr('fill', 'var(--cobalt)');

    const link = root.append('g').attr('class', 'graph-links')
      .selectAll('line').data(links).join('line')
      .attr('marker-end', 'url(#graph-arrow)');
    const node = root.append('g').attr('class', 'graph-nodes')
      .selectAll('g').data(nodes).join('g')
      .attr('class', 'graph-node')
      .attr('role', 'button')
      .attr('tabindex', 0)
      .attr('aria-label', (d: any) => `${d.title}${isLocal && d.id === focusPageId ? `, ${labels.currentPage}` : ''}, ${d.backlinks} ${labels.backlinks}`);
    node.append('circle').attr('r', (d: any) => radius(d.connections)).attr('fill', (d: any) => `var(--group-${groupColors[d.group] !== undefined ? d.group : 'other'})`);
    node.append('text').text((d: any) => d.title.length > 22 ? `${d.title.slice(0, 21)}…` : d.title).attr('x', (d: any) => radius(d.connections) + 5).attr('y', 4)
      .attr('opacity', initialLabelOpacity);
    node.append('title').text((d: any) => `${d.title}\n${d.backlinks} ${labels.backlinks} · ${d.connections} ${labels.neighbors}`);
    if (isLocal) node.filter((d: any) => d.id === focusPageId).raise();

    const render = () => {
      link.attr('x1', (d: any) => d.source.x).attr('y1', (d: any) => d.source.y).attr('x2', (d: any) => d.target.x).attr('y2', (d: any) => d.target.y);
      node.attr('transform', (d: any) => `translate(${d.x},${d.y})`);
      node.select('text')
        .attr('x', (d: any) => d.x > width - 110 ? -radius(d.connections) - 5 : radius(d.connections) + 5)
        .attr('text-anchor', (d: any) => d.x > width - 110 ? 'end' : 'start');
    };

    const zoom = d3.zoom<SVGSVGElement, unknown>()
      .scaleExtent([isLocal ? 0.2 : 0.35, 4])
      .on('zoom', (event) => {
        root.attr('transform', event.transform);
      });
    svg.call(zoom);

    const fitLocalView = () => {
      if (!isLocal || nodes.length === 0) return;
      let minX = Infinity;
      let maxX = -Infinity;
      let minY = Infinity;
      let maxY = -Infinity;
      for (const candidate of nodes) {
        if (!Number.isFinite(candidate.x) || !Number.isFinite(candidate.y)) continue;
        const nodeRadius = radius(candidate.connections);
        minX = Math.min(minX, candidate.x - nodeRadius);
        maxX = Math.max(maxX, candidate.x + nodeRadius);
        minY = Math.min(minY, candidate.y - nodeRadius);
        maxY = Math.max(maxY, candidate.y + nodeRadius);
      }
      if (!Number.isFinite(minX)) return;
      const padding = 22;
      const boundsWidth = Math.max(1, maxX - minX);
      const boundsHeight = Math.max(1, maxY - minY);
      const availableWidth = Math.max(1, width - padding * 2);
      const availableHeight = Math.max(1, height - padding * 2);
      const scale = Math.max(0.2, Math.min(1, availableWidth / boundsWidth, availableHeight / boundsHeight));
      const transform = d3.zoomIdentity
        .translate(width / 2 - scale * (minX + maxX) / 2, height / 2 - scale * (minY + maxY) / 2)
        .scale(scale);
      svg.call(zoom.transform, transform);
    };

    const hiddenGroups = new Set<string>();
    const groupKey = (d: any) => (groupColors[d.group] ? d.group : 'other');
    const applyGroupFilter = () => {
      node.style('display', (d: any) => hiddenGroups.has(groupKey(d)) ? 'none' : null);
      link.style('display', (d: any) => hiddenGroups.has(groupKey(nodeById.get(idOf(d.source)) || {})) || hiddenGroups.has(groupKey(nodeById.get(idOf(d.target)) || {})) ? 'none' : null);
    };
    wrapper.querySelectorAll<HTMLButtonElement>('[data-legend-group]').forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.legendGroup || '';
        if (hiddenGroups.has(key)) hiddenGroups.delete(key); else hiddenGroups.add(key);
        button.setAttribute('aria-pressed', hiddenGroups.has(key) ? 'false' : 'true');
        applyGroupFilter();
      });
    });

    const updateDetail = (focus = false) => {
      const selected = selectedId ? nodeById.get(selectedId) : undefined;
      if (!detail || !selected) {
        if (detail) detail.hidden = true;
        return;
      }
      detail.hidden = false;
      if (detailTitle) detailTitle.textContent = selected.title;
      if (detailSummary) detailSummary.textContent = `${selected.backlinks} ${labels.backlinks} · ${selected.connections} ${labels.neighbors}`;
      if (detailLink) {
        detailLink.href = pageHref(selected.id);
        detailLink.textContent = labels.openPage;
      }
      if (focus) detail.focus();
    };

    const updateInteraction = (focusDetail = false) => {
      const query = searchInput?.value || '';
      const matches = new Set(matchingGraphNodeIds(nodes, query));
      const focused = selectedId ? focusedGraphNodeIds(graph.edges, selectedId) : matches;
      const hasQuery = query.trim().length > 0;
      if (searchStatus) {
        searchStatus.hidden = !hasQuery || matches.size > 0;
        searchStatus.textContent = matches.size > 0 ? '' : labels.noResults;
      }
      node
        .attr('opacity', (candidate: any) => !focused.has(candidate.id) ? 0.14 : selectedId && candidate.id !== selectedId ? 0.7 : 1)
        .attr('tabindex', (candidate: any) => focused.has(candidate.id) ? 0 : -1)
        .style('pointer-events', (candidate: any) => focused.has(candidate.id) ? null : 'none')
        .classed('is-selected', (candidate: any) => candidate.id === selectedId)
        .classed('is-focus', (candidate: any) => isLocal && candidate.id === focusPageId)
        .classed('is-neighbor', (candidate: any) => Boolean(selectedId && candidate.id !== selectedId && focused.has(candidate.id)));
      node.select('text').attr('opacity', (candidate: any) => isLocal
        ? (candidate.id === focusPageId || candidate.id === selectedId ? 1 : 0)
        : focused.has(candidate.id) ? selectedId ? 1 : initialLabelOpacity(candidate) : 0);
      link.attr('opacity', (edge: any) => focused.has(idOf(edge.source)) && focused.has(idOf(edge.target)) ? null : 0.08);
      updateDetail(focusDetail);
    };

    const clearInteraction = (focusSearch = false) => {
      selectedId = undefined;
      if (searchInput) searchInput.value = '';
      updateInteraction();
      if (focusSearch) searchInput?.focus();
    };

    const selectNode = (id: string, focusDetail = false) => {
      if (!nodeById.has(id)) return;
      selectedId = id;
      if (searchInput) searchInput.value = '';
      updateInteraction(focusDetail);
    };

    const focusNode = isLocal && focusPageId ? nodeById.get(focusPageId) : undefined;
    if (focusNode) {
      focusNode.fx = width / 2;
      focusNode.fy = height / 2;
      focusNode.x = width / 2;
      focusNode.y = height / 2;
    }
    const simulation = d3.forceSimulation(nodes)
      .force('link', d3.forceLink(links).id((d: any) => d.id).distance(isLocal ? 38 : 110))
      .force('charge', d3.forceManyBody().strength(isLocal ? -55 : -280))
      .force('collision', d3.forceCollide().radius((d: any) => radius(d.connections) + (isLocal ? 6 : 20)))
      .force('center', d3.forceCenter(width / 2, height / 2))
      .on('tick', render);

    node.on('pointerover', function(_, hovered: any) {
      if (selectedId || searchInput?.value.trim()) return;
      const connected = adjacency.get(hovered.id) ?? new Set();
      node.attr('opacity', (candidate: any) => candidate.id === hovered.id || connected.has(candidate.id) ? 1 : 0.16);
      link.attr('opacity', (edge: any) => idOf(edge.source) === hovered.id || idOf(edge.target) === hovered.id ? 1 : 0.08);
      d3.select(this).select('text').attr('opacity', 1);
    }).on('pointerout', () => {
      if (!selectedId && !searchInput?.value.trim()) updateInteraction();
    }).on('click', (event: MouseEvent, selected: any) => {
      if (event.defaultPrevented) return;
      event.preventDefault();
      selectNode(selected.id);
    }).on('keydown', (event: KeyboardEvent, selected: any) => {
      const action = graphKeyboardAction(event.key);
      if (!action) return;
      event.preventDefault();
      if (action === 'select') selectNode(selected.id, true);
      else clearInteraction(true);
    });
    if (reducedMotion || isLocal) {
      simulation.stop();
      for (let tick = 0; tick < 180; tick += 1) simulation.tick();
      render();
      if (isLocal) fitLocalView();
    }

    const isPinnedFocus = (candidate: any) => Boolean(focusNode && candidate === focusNode);
    node.call(d3.drag<any, any>()
      .on('start', (event, d) => {
        if (!reducedMotion && !event.active) simulation.alphaTarget(0.25).restart();
        if (isPinnedFocus(d)) {
          d.fx = width / 2;
          d.fy = height / 2;
        } else {
          d.fx = d.x;
          d.fy = d.y;
        }
      })
      .on('drag', (event, d) => {
        d.fx = isPinnedFocus(d) ? width / 2 : event.x;
        d.fy = isPinnedFocus(d) ? height / 2 : event.y;
        if (reducedMotion) {
          d.x = d.fx;
          d.y = d.fy;
          render();
        }
      })
      .on('end', (event, d) => {
        if (!reducedMotion && !event.active) simulation.alphaTarget(0);
        if (isPinnedFocus(d)) {
          d.fx = width / 2;
          d.fy = height / 2;
        } else {
          d.fx = null;
          d.fy = null;
        }
        if (reducedMotion) render();
      }));

    const resetZoom = () => {
      if (isLocal) {
        fitLocalView();
        return;
      }
      if (reducedMotion) svg.call(zoom.transform, d3.zoomIdentity);
      else svg.transition().duration(250).call(zoom.transform, d3.zoomIdentity);
    };
    const handleGraphKeydown = (event: KeyboardEvent) => {
      if (!isLocal) return;
      const zoomFactor = event.key === '+' || event.key === '=' ? 1.25 : event.key === '-' || event.key === '_' ? 0.8 : undefined;
      const pan = event.key === 'ArrowLeft' ? [-28, 0] : event.key === 'ArrowRight' ? [28, 0] : event.key === 'ArrowUp' ? [0, -28] : event.key === 'ArrowDown' ? [0, 28] : undefined;
      if (zoomFactor === undefined && pan === undefined) return;
      event.preventDefault();
      if (zoomFactor !== undefined) svg.call(zoom.scaleBy, zoomFactor, [width / 2, height / 2]);
      else if (pan) svg.call(zoom.translateBy, pan[0], pan[1]);
    };
    if (isLocal) element.addEventListener('keydown', handleGraphKeydown);
    resetButton?.addEventListener('click', () => {
      clearInteraction();
      resetZoom();
    });
    searchInput?.addEventListener('input', () => {
      selectedId = undefined;
      updateInteraction();
    });
    searchInput?.addEventListener('keydown', (event) => {
      if (graphKeyboardAction(event.key) !== 'clear') return;
      event.preventDefault();
      clearInteraction();
    });
    detail?.addEventListener('keydown', (event) => {
      if (graphKeyboardAction(event.key) !== 'clear') return;
      event.preventDefault();
      clearInteraction(true);
    });
    const resize = () => {
      const next = size();
      if (next.width === width && next.height === height) return;
      width = next.width;
      height = next.height;
      svg.attr('viewBox', [0, 0, width, height]);
      simulation.force('center', d3.forceCenter(width / 2, height / 2));
      if (focusNode) {
        focusNode.fx = width / 2;
        focusNode.fy = height / 2;
        focusNode.x = width / 2;
        focusNode.y = height / 2;
      }
      if (isLocal) {
        render();
        return;
      }
      if (reducedMotion) {
        simulation.stop();
        for (let tick = 0; tick < 180; tick += 1) simulation.tick();
        render();
      } else {
        simulation.alpha(0.35).restart();
      }
    };
    const stopResize = observeResize(window, resize);
    window.addEventListener('pagehide', () => {
      stopResize();
      if (isLocal) element.removeEventListener('keydown', handleGraphKeydown);
      simulation.stop();
    }, { once: true });
    updateInteraction();
  }
</script>

<style>
  .graph-wrap { position:relative; padding:0; overflow:hidden; }
  .graph-wrap { --group-entities:#ff7a59; --group-concepts:#2dd4bf; --group-facts:#fbbf24; --group-comparisons:#c084fc; --group-workflows:#60a5fa; --group-prompts:#f472b6; --group-cases:#a3e635; --group-sources:#94a3b8; --group-other:#cbd5e1; }
  .graph-legend { position:absolute; z-index:1; top:auto; right:14px; bottom:14px; display:flex; flex-wrap:wrap; gap:4px 12px; max-width:min(420px,60%); margin:0; padding:7px 10px; list-style:none; border:2px solid var(--line); background:var(--panel); color:var(--muted); font-size:.74rem; }
  .graph-legend li { display:inline-flex; }
  .graph-legend button { display:inline-flex; align-items:center; gap:5px; padding:2px 4px; border:0; background:transparent; color:inherit; font:inherit; cursor:pointer; }
  .graph-legend button:hover { color:var(--text); background:var(--soft); }
  .graph-legend button[aria-pressed="false"] { opacity:.4; text-decoration:line-through; }
  .graph-legend .swatch { width:11px; height:11px; border-radius:50%; border:1.5px solid var(--line); }
  .graph-wrap--loom { border:1px solid var(--line); background:var(--panel); box-shadow:none; }
  .graph-tools { position:absolute; z-index:1; inset:14px 14px auto; display:flex; justify-content:space-between; align-items:start; gap:12px; pointer-events:none; }
  .graph-summary { max-width:260px; padding:8px 10px; border:2px solid var(--line); background:var(--panel); box-shadow:3px 3px 0 var(--line); color:var(--muted); font-size:.75rem; line-height:1.35; }
  .graph-summary p { margin:0 0 2px; color:var(--text); font-size:.82rem; font-weight:850; letter-spacing:.04em; }
  .graph-actions { display:grid; grid-template-columns:minmax(130px,1fr) auto; align-items:end; gap:8px; pointer-events:auto; }
  .graph-search { display:grid; gap:3px; color:var(--muted); font-size:.7rem; font-weight:800; letter-spacing:.04em; }
  .graph-search input { width:100%; min-height:36px; border:2px solid var(--line); border-radius:0; padding:6px 8px; background:var(--panel); color:var(--text); font:inherit; letter-spacing:normal; }
  .graph-search input:focus { outline:3px solid var(--cobalt); outline-offset:2px; }
  .graph-search-status { grid-column:1 / -1; margin:0; padding:5px 7px; border:1px solid var(--line); background:var(--panel); color:var(--muted); font-size:.72rem; }
  .graph-tools button { min-height:36px; padding:7px 10px; border:2px solid var(--line); border-radius:0; background:var(--lime); box-shadow:3px 3px 0 var(--line); color:#09111a; font:inherit; font-size:.78rem; font-weight:800; cursor:pointer; pointer-events:auto; }
  .graph-tools button:hover { background:var(--cobalt); color:var(--panel); }
  .graph-detail { position:absolute; z-index:1; inset:auto 14px 14px; width:min(300px,calc(100% - 28px)); padding:12px; border:2px solid var(--line); background:var(--panel); box-shadow:4px 4px 0 var(--line); pointer-events:auto; }
  .graph-detail[hidden] { display:none; }
  .graph-detail .label { margin-bottom:4px; }
