{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hatwiki",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "WIKI_REPO": "daubas/webmcp-okf",
    "WIKI_REF": "main",
    "WIKI_ROOT": "."
  },
  "d1_databases": [{
    "binding": "HATWIKI_STATE",
    "database_name": "hatwiki-state",
    "database_id": "1f89cbb9-9bd9-424f-a164-9842b1861a63",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "HATWIKI_PUBLIC",
    "bucket_name": "hatwiki-public"
  }]
}
